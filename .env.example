# Bu dosyayı `.env` olarak kopyalayın. `.env` git'e commit edilmez.
DB_NAME=workflowdb
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# JWT imzalama anahtari. En az 32 karakter olmali (HMAC-SHA256 kisitlamasi).
# Her ortam icin farkli ve gizli bir deger uretin.
JWT_SECRET=yerel-gelistirme-icin-en-az-32-karakter-uzunlugunda-gecici-anahtar

# Ilk yerel Admin yalnizca aktif bir Admin yoksa olusturulur.
# Gercek parolayi .env icinde tutun; bu dosyaya yazmayin.
BOOTSTRAP_ADMIN_EMAIL=admin@local.test
BOOTSTRAP_ADMIN_PASSWORD=guvenli-bir-yerel-parola

# Frontend'in baglanacagi backend sunucusu.
VITE_API_BASE_URL=http://localhost:8080

# Tarihler sunucu yerel saatiyle saklanir. Sunucu UTC ise (bulut VM'lerinin
# varsayilani) butun kayit saatleri geride gorunur.
TZ=Europe/Istanbul

# --- Mobil push (FCM) ---
# Ucu birden bos birakilirsa FCM devre disi kalir ve push gonderimi atlanir.
# Gercek servis hesabi anahtarini .env icinde tutun; bu dosyaya yazmayin.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- TEST ortami (docker-compose.test.yml) ---
# Yalnizca sunucuda doldurulur; yerel gelistirmede gerekmez.
#
# Caddy'nin sertifika alacagi alan adi. IP adresi calismaz.
TEST_DOMAIN=
# Mailpit arayuzunun basic auth bilgileri. Arayuz parola sifirlama kodlarini
# gosterdigi icin korumasiz birakilamaz. Hash uretmek icin:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext PAROLA
MAILPIT_USER=
MAILPIT_PASSWORD_HASH=
# TEST'te bunlar public adrese cekilir, orn:
#   CORS_ALLOWED_ORIGINS=https://ornek.duckdns.org,http://localhost:5173
#   FRONTEND_URL=https://ornek.duckdns.org
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

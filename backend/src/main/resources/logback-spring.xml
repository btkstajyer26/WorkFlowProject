<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_PATH" value="logs"/>

    <!-- Konsol: gelistirici gozuyle okunan duz metin. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Dosya: sartname §6.2 "structured log formatinda" diyor, bu yuzden duz
        metin degil JSON yazilir (ECS semasi). Encoder Spring Boot'un kendi
        yapilandirmasi; ek bagimlilik gerekmez.
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/application-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
        </encoder>
    </appender>

    <!--
        DEBUG yalnizca gelistirmede. Onceki hali profilden bagimsiz DEBUG'di;
        o haliyle uretimde de her SQL ve ic cagri diske yazilirdi.
    -->
    <springProfile name="dev">
        <logger name="btk.staj.WorkFlowProject" level="DEBUG"/>
    </springProfile>
    <springProfile name="!dev">
        <logger name="btk.staj.WorkFlowProject" level="INFO"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
